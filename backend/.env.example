# ---------------------------------------------------------------------------
# HVAC Protection Plan Management System - backend configuration
# Copy this file to `.env` and fill in the values for your machine.
# `.env` is git-ignored: never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# MySQL connection string (PyMySQL driver).
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
#
# Create the database first:  CREATE DATABASE hvac_db;
# If your password contains @ : / # or ? it must be percent-encoded, e.g.
# "p@ss#1" becomes "p%40ss%231".
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/hvac_db?charset=utf8mb4

# --- Security -------------------------------------------------------------
# Generate a fresh secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS -----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=https://hvac-protection-platform.onrender.com

# --- Email (SMTP) ---------------------------------------------------------
# EMAIL_MODE controls how notifications are delivered:
#   console  -> emails are printed to the backend console (default, no setup)
#   file     -> emails are written as .html files into EMAIL_OUTPUT_DIR
#   smtp     -> emails are sent through the SMTP server configured below
EMAIL_MODE=console
EMAIL_OUTPUT_DIR=sent_emails

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@hvacdemo.com
EMAIL_FROM_NAME=Summit Air Protection Plans

# Address that receives the internal "new customer" / "new purchase" alerts.
ADMIN_NOTIFICATION_EMAIL=admin@hvacdemo.com

# --- App ------------------------------------------------------------------
APP_NAME=HVAC Protection Plan API
ENVIRONMENT=development
CUSTOMER_APP_URL=https://hvac-protection-platform.onrender.com
ADMIN_APP_URL=https://admin-frontend-cg6k.onrender.com

# --- AWS (photo storage + activity history) --------------------------------
# NO access keys here. On EC2 the backend uses the instance role
# (hvac-prod-backend-ec2). Locally, run with AWS_PROFILE=hvac-dev exported in
# your shell, or leave the two names below empty: uploads then return 503 and
# activity events wait in the MySQL outbox.
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
DYNAMODB_ACTIVITY_TABLE=

# Optional tuning (defaults shown).
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_URL_EXPIRY_SECONDS=300
# DOWNLOAD_URL_EXPIRY_SECONDS=300
# MAX_PHOTOS_PER_CATEGORY=10
# PENDING_UPLOAD_TTL_MINUTES=60
# ACTIVITY_WORKER_ENABLED=true
# ACTIVITY_WORKER_INTERVAL_SECONDS=30
