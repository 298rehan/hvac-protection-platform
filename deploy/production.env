# Non-secret production settings, committed so they reach the server with every
# `git pull` and persist across deploys. compose.yml loads this file first; the
# server's own .env / backend/.env can override any value.
#
# NO secrets here - no passwords, keys or tokens. AWS credentials come from the
# EC2 instance role (hvac-prod-backend-ec2); JWT_SECRET_KEY and DATABASE_URL
# live only in the server's .env.

AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=hvac-prod-media-594775505885-ap-southeast-2
DYNAMODB_ACTIVITY_TABLE=hvac-prod-service-activity
