# --- Secrets -----------------------------------------------------------
# Broad on purpose: catches .env, .env.local, .env.*.bak and friends.
.env*
!.env.example

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
backend/sent_emails/

# --- Node / Next -------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# --- Editors / OS ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# --- Terraform ---------------------------------------------------------
# State and plans can contain resource details; never commit them.
# (.terraform.lock.hcl IS committed so provider versions stay pinned.)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
terraform/backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
